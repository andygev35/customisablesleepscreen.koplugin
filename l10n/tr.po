msgstr "'%s' önayarına geçildi"

#, lua-format
msgid "Already on '%s' - no change needed"
msgstr "Zaten '%s' üzerinde - değişiklik gerekmiyor"

#, lua-format
msgid "Day preset: %s"
msgstr "Gündüz önayarı: %s"

msgid "Preset to switch to outside the night window."
msgstr "Gece aralığı dışında geçilecek önayar."

#, lua-format
msgid "Night preset: %s"
msgstr "Gece önayarı: %s"

msgid "Preset to switch to during the night window."
msgstr "Gece aralığı boyunca geçilecek önayar."

msgid "Follow KOReader's night mode"
msgstr "KOReader'ın gece modunu takip et"

msgid "Time window"
msgstr "Zaman aralığı"

#, lua-format
msgid "Trigger: %s"
msgstr "Tetikleyici: %s"

msgid ""
"How the schedule decides when to switch: a fixed time window, or KOReader's "
"own night mode setting (useful if you toggle that manually rather than on a "
"fixed schedule)."
msgstr ""
"Zamanlamanın ne zaman geçiş yapacağına nasıl karar verdiği: sabit bir zaman "
"aralığı veya KOReader'ın kendi gece modu ayarı (sabit bir zamanlama yerine "
"bunu elle açıp kapatıyorsanız kullanışlıdır)."

msgid "Switch based on the start/end times."
msgstr "Başlangıç/bitiş saatlerine göre geçiş yap."

msgid ""
"Switch to the night preset whenever KOReader's own night mode is turned on, "
"and back to the day preset when it's off."
msgstr ""
"KOReader'ın kendi gece modu açıldığında gece önayarına, kapandığında ise "
"gündüz önayarına geri geç."

#, lua-format
msgid "Night window start: %02d:%02d"
msgstr "Gece aralığı başlangıcı: %02d:%02d"

msgid "Time of day the night preset starts being used."
msgstr "Gece önayarının kullanılmaya başlandığı saat."

msgid "Night window start"
msgstr "Gece aralığı başlangıcı"

msgid "Enter time in hours and minutes."
msgstr "Saati saat ve dakika olarak girin."

msgid "Set time"
msgstr "Saati ayarla"

#, lua-format
